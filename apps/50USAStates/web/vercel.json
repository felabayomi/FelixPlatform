{
    "framework": null,
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "outputDirectory": "dist/public",
    "crons": [
        {
            "path": "/api/cron/generate-tomorrow",
            "schedule": "0 20 * * *"
        },
        {
            "path": "/api/cron/auto-publish",
            "schedule": "0 4 * * *"
        }
    ],
    "functions": {
        "api/[...slug].ts": {
            "maxDuration": 300
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/[...slug]"
        },
        {
            "src": "/((?!assets/|favicon|manifest|uploads/).*)",
            "dest": "/index.html"
        }
    ]
}